{
  "name": "vunio",
  "version": "0.1.0",
  "description": "Vunio —— 基于 Web Components 的风格化组件框架",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./core/*": "./src/core/*",
    "./effects": "./src/effects/index.js",
    "./components": "./src/components/index.js",
    "./components/*": "./src/components/*",
    "./themes/*": "./themes/*"
  },
  "files": [
    "src",
    "themes"
  ],
  "scripts": {
    "dev": "node scripts/serve.js",
    "build:theme": "node scripts/build-theme.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
