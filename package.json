{
  "name": "vunio",
  "version": "0.1.0",
  "description": "Vunio —— 基于 Web Components 的风格化组件框架",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./core/*": "./src/core/*",
    "./effects": "./src/effects/index.js",
    "./components": "./src/components/index.js",
    "./components/*": "./src/components/*",
    "./themes/*": "./themes/*",
    "./router": "./src/router/index.js"
  },
  "files": [
    "src",
    "themes"
  ],
  "scripts": {
    "dev": "node scripts/serve.js",
    "build:theme": "node scripts/build-theme.js",
    "build:docs": "node scripts/build-docs.js",
    "typecheck": "tsc -p jsconfig.json",
    "size": "node scripts/size.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "check": "npm run typecheck && node scripts/size.js --check && npm test",
    "bench": "node bench/run.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3"
  }
}
